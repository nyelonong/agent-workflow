#!/bin/sh
# Prewalk for Claude Code: a strong model plans and makes the first edit in a
# print-mode phase; a hook ends that phase at the second edit; the same session
# resumes interactively on a cheaper model. The system-prompt addendum differs
# per phase and is not stored in the transcript, so the plan nudge vanishes.
set -eu

usage() {
  cat <<'USAGE' >&2
usage: claude-prewalk [--from MODEL] [--into MODEL] [--cwd DIR] [--permission-mode MODE] -- TASK...
  --from MODEL           strong model for phase 1 (default: fable)
  --into MODEL           cheap model for phase 2 (default: sonnet)
  --cwd DIR              run both phases in DIR (default: current directory)
  --permission-mode MODE pass through to phase 1 (default: inherit settings)
Put -- before a task that starts with a dash.
USAGE
  exit 64
}

self="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
repo_dir="$(cd "$(dirname "$self")/../../.." && pwd -P)"
render="$repo_dir/scripts/prewalk_render.py"

from_model="fable"
into_model="sonnet"
work_dir=""
permission_mode=""
from_set=""
into_set=""
while [ $# -gt 0 ]; do
  case "$1" in
    --from) [ $# -ge 2 ] || usage; from_model="$2"; from_set=1; shift 2 ;;
    --into) [ $# -ge 2 ] || usage; into_model="$2"; into_set=1; shift 2 ;;
    --cwd) [ $# -ge 2 ] || usage; work_dir="$2"; shift 2 ;;
    --permission-mode) [ $# -ge 2 ] || usage; permission_mode="$2"; shift 2 ;;
    --) shift; break ;;
    -h|--help) usage ;;
    -*) usage ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || usage
task="$*"
# Flags win over ~/.claude/prewalk.json, which wins over shipped defaults.
config_values="$(python3 "$repo_dir/scripts/prewalk_config.py" claude from into permissionMode)" || config_values=""
while IFS='=' read -r key value; do
  [ -n "$key" ] || continue
  case "$key" in
    from) [ -n "$from_set" ] || from_model="$value" ;;
    into) [ -n "$into_set" ] || into_model="$value" ;;
    permissionMode) [ -n "$permission_mode" ] || permission_mode="$value" ;;
  esac
done <<CONFIG
$config_values
CONFIG
[ -z "$work_dir" ] || cd "$work_dir"

plan_nudge='Prewalk phase 1. Before any further exploration, write the complete plan for this task in your next reply: every remaining step in order with exact files, symbols, commands and checks; the risks and how each step is verified; what is already done. Then restate it as a numbered checklist of 5-9 concrete items, each naming its target and its verification, and use TodoWrite for it only if that tool exists. Then continue into implementation. Do not ask for approval: implementation of this exact scope is already approved. When a tool call is denied with a prewalk handoff reason, stop editing immediately and end your turn with a short summary of the remaining todo items.'
checklist='Prewalk phase 2. You are continuing a session whose plan, todo list and first edit are already in this conversation; do not redo them. Before you consider the task finished, verify: consistency (grep for every other call site of a changed pattern), scope (smallest correct diff, no behavior change outside the task), verification (run the whole test module the change lives in, not one test). Do not claim completion before those three checks.'

session_id="$(uuidgen | tr 'A-Z' 'a-z')"
state_file="$(mktemp "${TMPDIR:-/tmp}/claude-prewalk.XXXXXX")"
trap 'rm -f "$state_file"' EXIT

printf 'prewalk: phase 1 on %s (session %s)\n' "$from_model" "$session_id" >&2
set -- claude -p "$task" --session-id "$session_id" --model "$from_model" \
  --append-system-prompt "$plan_nudge" --output-format stream-json --verbose
[ -z "$permission_mode" ] || set -- "$@" --permission-mode "$permission_mode"
if ! CLAUDE_PREWALK_STATE="$state_file" "$@" </dev/null | python3 "$render"; then
  printf 'prewalk: phase 1 did not start or ended abnormally; not resuming\n' >&2
  exit 1
fi

if grep -qx edit "$state_file" 2>/dev/null; then
  resume_model="$into_model"
  printf 'prewalk: first edit recorded; phase 2 on %s\n' "$into_model" >&2
  continue_text="Continue from the todo list. The first edit is already applied; finish the remaining items."
else
  resume_model="$from_model"
  printf 'prewalk: no edit recorded in phase 1; resuming on %s instead\n' "$from_model" >&2
  continue_text="Continue the task from where the previous turn stopped."
fi
unset CLAUDE_PREWALK_STATE
rm -f "$state_file"
trap - EXIT
exec claude --resume "$session_id" --model "$resume_model" --append-system-prompt "$checklist" "$continue_text"
